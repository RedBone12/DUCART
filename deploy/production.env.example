# Generate a private file with: node scripts/ops.cjs init --env deploy/production.env --origin https://shop.example.com
# Never deploy these placeholders. Do not commit the generated file or backups.
PUBLIC_ORIGIN=https://shop.example.com
SITE_HOST=shop.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TLS_DIRECTIVE=
MYSQL_DATABASE=ducart
MYSQL_USER=ducart
MYSQL_PASSWORD=GENERATE_A_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=GENERATE_A_DIFFERENT_RANDOM_PASSWORD
JWT_SECRET=GENERATE_A_BASE64_KEY
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
PASSWORD_RESET_MAIL_FROM=no-reply@shop.example.com
