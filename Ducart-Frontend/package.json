{
  "name": "ecom",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.8",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/user-event": "^13.5.0",
    "datatables.net": "^2.1.8",
    "datatables.net-dt": "^2.1.8",
    "password-validator": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-owl-carousel": "^2.3.3",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "react-scripts": "5.0.1",
    "redux-saga": "^1.3.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src e2e playwright.config.cjs --ext .js,.jsx,.cjs --max-warnings 0",
    "coverage": "react-scripts test --watchAll=false --runInBand --coverage",
    "test:e2e": "playwright test",
    "e2e:serve": "serve -s build -l tcp://127.0.0.1:3001 --no-clipboard",
    "e2e:build": "node e2e/build.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "e2e/**/*.cjs",
          "playwright.config.cjs"
        ],
        "env": {
          "node": true
        }
      },
      {
        "files": [
          "e2e/**/*.cjs"
        ],
        "extends": [
          "plugin:playwright/recommended"
        ],
        "rules": {
          "testing-library/prefer-screen-queries": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^14.3.1",
    "eslint": "8.57.1",
    "eslint-plugin-playwright": "2.12.1",
    "serve": "14.2.6"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/setupTests.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "clover",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  }
}
